# =====================================================================
# YSBK Backend Configuration Environment Variables Template (.env.example)
# TUYỆT ĐỐI KHÔNG LƯU MẬT KHẨU / SECRET THẬT VÀO TỆP NÀY HOẶC COMMIT GIT.
# =====================================================================

# 1. Cơ sở dữ liệu PostgreSQL (Local / Container)
# Tên database test disposable bắt buộc phải bắt đầu bằng 'ysbk_test_'
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ysbk_test_stage03
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ysbk_test_stage03

# 2. Managed Auth Provider (Supabase Auth / GoTrue)
# Các giá trị dưới đây là placeholder; cần lấy từ Supabase Project Dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder-admin-only

# 3. Session & JWT Signing Secret (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=your-random-jwt-secret-key-min-32-chars-replace-in-production

# 4. Môi trường chạy
NODE_ENV=development

# 5. Cloudflare Turnstile CAPTCHA (Cổng đặt sách công khai)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_EXPECTED_HOSTNAME=localhost

# 6. Bí mật băm IP đặt sách (HMAC Salt)
RESERVATION_IP_SECRET=your-random-ip-secret-key-min-32-chars-replace-in-production

# Beta cloud: xem docs/technical/beta-deployment-guide.md.
# Build dùng .env.beta.local với site key thật. Runtime secrets đặt tại Cloudflare.
# Production dùng binding HYPERDRIVE thay cho DATABASE_URL; không bật SQL query cache.
