{
  "name": "ysbk-landing-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone static YSBK book landing preview; no library web application.",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-landing.mjs",
    "build:landing": "node scripts/build-landing.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:landing": "node --test tests/integration/landing-preview.test.mjs",
    "test": "pnpm run test:unit && pnpm run build && pnpm run test:landing"
  },
  "dependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "onlyBuiltDependencies": [
    "esbuild"
  ]
}
