erDiagram
    %% Toàn bộ lược đồ ERD hệ thống YSBK

    book_titles ||--o{ book_editions : "has editions"
    book_titles ||--o{ book_title_authors : "authored by"
    book_titles ||--o{ book_title_categories : "categorized as"
    authors ||--o{ book_title_authors : "writes"
    categories ||--o{ book_title_categories : "classifies"
    book_editions ||--o{ book_copies : "has physical copies"

    borrowers ||--o{ loan_receipts : "issues loans"
    loan_receipts ||--|{ loan_items : "contains (1 or 2)"
    book_copies ||--o{ loan_items : "borrowed in"
    members ||--o{ loan_receipts : "created by"

    funds ||--o{ journal_entries : "owns balance"
    members ||--o{ cash_sessions : "managed by"
    members ||--o{ journal_entries : "posted by"

    duty_shifts ||--|{ duty_assignments : "has assignees"
    members ||--o{ duty_assignments : "assigned to"

    recruitment_drives ||--o{ candidates : "applies to"
    candidates ||--o{ candidate_scores : "scored by"
    candidates ||--o{ score_audit_logs : "score history"
    members ||--o{ candidate_scores : "evaluates"

    book_titles ||--o{ book_reviews : "reviewed in"
    members ||--o{ book_reviews : "moderated by"

    book_titles {
        UUID id PK
        VARCHAR title
        VARCHAR original_title
        TEXT description
        tsvector search_vector
    }

    book_copies {
        UUID id PK
        UUID edition_id FK
        VARCHAR barcode UK
        copy_location location
        copy_status status
        BIGINT cover_price
    }

    borrowers {
        UUID id PK
        VARCHAR full_name
        VARCHAR student_id
        VARCHAR school
        VARCHAR phone
    }

    loan_receipts {
        UUID id PK
        VARCHAR receipt_number UK
        UUID borrower_id FK
        DATE borrow_date
        DATE due_date
        SMALLINT renew_count
        loan_status status
        UUID preceding_receipt_id FK
    }

    loan_items {
        UUID id PK
        UUID receipt_id FK
        UUID copy_id FK
        BIGINT deposit_snapshot
        TIMESTAMPTZ returned_at
        BOOLEAN is_lost
    }

    funds {
        VARCHAR id PK
        VARCHAR name
        TEXT description
    }

    cash_sessions {
        VARCHAR id PK
        DATE session_date
        UUID opened_by FK
        BIGINT opening_cash
        BIGINT expected_closing_cash
        BIGINT actual_closing_cash
        BOOLEAN is_closed
    }

    journal_entries {
        UUID id PK
        VARCHAR entry_code UK
        VARCHAR fund_id FK
        VARCHAR debit_account
        VARCHAR credit_account
        BIGINT amount
    }

    members {
        UUID id PK
        VARCHAR full_name
        VARCHAR username UK
        member_team team
        VARCHAR role_title
        BOOLEAN is_eligible_main_duty
        BOOLEAN has_paid_fee
        BOOLEAN is_alumni
    }
