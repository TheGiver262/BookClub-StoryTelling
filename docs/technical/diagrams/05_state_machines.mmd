stateDiagram-v2
    %% Máy trạng thái Bản Sách, Phiếu Mượn và Thành Viên

    state "VÒNG ĐỜI BẢN SÁCH VẬT LÝ" as BookCopyLifecycle {
        [*] --> AVAILABLE : Nhập kho / Gán barcode
        AVAILABLE --> BORROWED : Quét mã cho mượn tại bàn
        BORROWED --> AVAILABLE : Trả sách vật lý kiểm tra nguyên vẹn
        BORROWED --> LOST : Bạn đọc báo mất sách / Mất cọc
        AVAILABLE --> MAINTENANCE : Sách rách nát cần dán sửa
        MAINTENANCE --> AVAILABLE : Sửa chữa xong
    }

    state "VÒNG ĐỜI PHIẾU MƯỢN" as LoanReceiptLifecycle {
        [*] --> ACTIVE : Tạo phiếu mượn (Max 2 cuốn, hạn 14 ngày)
        ACTIVE --> ACTIVE : Gia hạn trong hạn (Cộng 14 ngày vào hạn cũ)
        ACTIVE --> OVERDUE : Quá hạn 14 ngày (Bắt đầu tính phạt 1k/ngày cả phiếu)
        OVERDUE --> ACTIVE : Gia hạn sau quá hạn (Chốt phạt cũ, cấp 14 ngày mới)
        ACTIVE --> PARTIAL_SETTLED : Trả 1 cuốn, giữ 1 cuốn (Lập phiếu chuyển tiếp mới)
        OVERDUE --> PARTIAL_SETTLED : Trả 1 cuốn, quyết toán phạt cũ, chuyển tiếp
        ACTIVE --> RETURNED : Trả đủ toàn bộ sách (Hoàn cọc)
        OVERDUE --> RETURNED : Trả đủ toàn bộ sách (Hoàn cọc & Thu phạt riêng)
        PARTIAL_SETTLED --> [*] : Phiếu cũ đóng lại, dữ liệu sống ở phiếu mới
        RETURNED --> [*] : Tất toán hoàn tất
    }

    state "VÒNG ĐỜI THÀNH VIÊN & DANH TÍNH" as MemberLifecycle {
        [*] --> ACTIVE_MEMBER : Admin cấp Username nội bộ + Mật khẩu
        ACTIVE_MEMBER --> ACTIVE_MEMBER : Tham gia trực hỗ trợ -> Đủ điều kiện trực chính
        ACTIVE_MEMBER --> ALUMNI : Ra trường / Tốt nghiệp (Chuyển Cựu thành viên)
        ALUMNI --> ALUMNI : Xem hoạt động an toàn (Không tiền/PII/ghi)
        ACTIVE_MEMBER --> LOCKED : Vi phạm bảo mật / Khóa tài khoản
        ALUMNI --> LOCKED : Khóa tài khoản cựu
        LOCKED --> [*] : Vô hiệu hóa toàn bộ phiên truy cập
    }
