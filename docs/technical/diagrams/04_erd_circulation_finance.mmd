erDiagram
    %% Phóng đại chi tiết vùng Mượn–Trả, Cọc & Hai Quỹ

    funds ||--o{ journal_entries : "quỹ sở hữu bút toán"
    cash_sessions ||--o{ journal_entries : "phiên phát sinh tiền mặt"
    loan_receipts ||--|{ loan_items : "gồm 1 hoặc 2 bản sách"
    loan_receipts ||--o{ journal_entries : "chứng từ gốc của cọc/phạt"
    loan_receipts ||--o{ loan_receipts : "liên kết phiếu chuyển tiếp"

    loan_receipts {
        UUID id PK "Khóa chính phiếu mượn"
        VARCHAR receipt_number UK "Mã phiếu YSBK-PM-..."
        UUID borrower_id FK "Người mượn"
        DATE borrow_date "Ngày mượn"
        DATE due_date "Hạn trả (đúng 14 ngày)"
        SMALLINT renew_count "Số lần gia hạn (0-3)"
        VARCHAR status "ACTIVE | OVERDUE | PARTIAL_SETTLED | RETURNED"
        UUID preceding_receipt_id FK "Phiếu cũ trước khi chuyển tiếp"
    }

    loan_items {
        UUID id PK "Khóa chính dòng mượn"
        UUID receipt_id FK "Mã phiếu"
        UUID copy_id FK "Mã bản sách vật lý"
        BIGINT deposit_snapshot "Tiền cọc từng cuốn tại lúc mượn"
        TIMESTAMPTZ returned_at "Ngày giờ trả thực tế"
        BOOLEAN is_lost "Đánh dấu mất sách"
    }

    funds {
        VARCHAR id PK "FUND_LOAN hoặc FUND_OPERATION"
        VARCHAR name "Tên quỹ"
    }

    cash_sessions {
        VARCHAR id PK "CS-YYYYMMDD"
        DATE session_date "Ngày quầy trực"
        BIGINT opening_cash "Tiền đầu ca cất tủ qua"
        BIGINT expected_closing_cash "Tiền dự kiến sổ sách"
        BIGINT actual_closing_cash "Tiền thực đếm cuối ca"
        BIGINT discrepancy "Chênh lệch nếu có"
        BOOLEAN is_closed "Đã chốt sổ và khóa tủ"
    }

    journal_entries {
        UUID id PK "Định danh bút toán"
        VARCHAR entry_code UK "Mã chứng từ BT-..."
        VARCHAR fund_id FK "Thuộc Quỹ 1 hay Quỹ 2"
        VARCHAR source_type "LOAN_DEPOSIT | DEPOSIT_REFUND | FINE_COLLECTION"
        UUID source_id "ID phiếu hoặc chứng từ nguồn"
        VARCHAR debit_account "Tài khoản Nợ (TIEN_MAT_HOP, TIEN_NGAN_HANG)"
        VARCHAR credit_account "Tài khoản Có (COC_PHAI_HOAN, THU_PHAT)"
        BIGINT amount "Số tiền nguyên VND (Nợ = Có)"
    }
