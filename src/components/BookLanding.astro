---
import '../styles/book-landing.css';
import LandingLink from './LandingLink.astro';
---

<a class="skip" href="#cach-muon">Đi đến hướng dẫn mượn sách</a>
<div class="scroll-track" id="scroll-track"><main class="stage" aria-label="Cuốn sách giới thiệu CLB Yêu Sách Bách Khoa"><h1 class="sr-only">Câu lạc bộ Yêu Sách Bách Khoa Hà Nội</h1>
<div class="desk-ring" aria-hidden="true"></div>
<header class="topbar"><div class="top-left"><a class="wordmark" href="#" id="home-link">Câu lạc bộ Yêu Sách Bách Khoa Hà Nội</a></div><nav class="top-actions" aria-label="Lối vào nhanh"><LandingLink href="/sach/" target="ysbk-public" rel="noopener" class="catalog-link">Tủ sách CLB ↗</LandingLink><LandingLink href="/sach/?tab=tra-don" class="subtle">Đăng nhập</LandingLink></nav></header>
<aside class="hint"><p><strong id="hint-title">Cuộn xuống để mở sách</strong><br><span id="hint-copy">Mỗi vòng cuộn, một trang mới.</span></p><span class="hint-line" aria-hidden="true"></span></aside>
<div class="book-area"><div class="book-shell" id="book-shell">
<div class="book-bed" id="book-bed"></div><div class="page-edges" id="page-edges"></div><div class="spread" id="base-spread" role="region" aria-label="Trang đang đọc"></div>
<div class="turn-leaf" id="turn-leaf" aria-hidden="true"><div class="leaf-face leaf-front" id="turn-front"></div><div class="leaf-face leaf-back" id="turn-back"></div><div class="turn-shade" id="turn-shade"></div></div>
<div class="curl-faces" id="curl-faces" aria-hidden="true" inert><div class="curl-front-holder" id="curl-front"></div><div class="curl-back-holder" id="curl-back"><div class="curl-back-content" id="curl-back-content"></div></div><svg class="curl-art" id="curl-art" aria-hidden="true"><defs><linearGradient id="curl-gradient" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#354a32" stop-opacity="0"/><stop offset=".22" stop-color="#354a32" stop-opacity=".2"/><stop offset=".49" stop-color="#fffdf0" stop-opacity=".94"/><stop offset=".73" stop-color="#8a8c69" stop-opacity=".25"/><stop offset="1" stop-color="#8a8c69" stop-opacity="0"/></linearGradient></defs><polygon class="curl-cast" id="curl-cast"/><path class="curl-ridge" id="curl-ridge" stroke="url(#curl-gradient)"/></svg></div>
<div class="gutter" id="gutter" aria-hidden="true"></div><div class="ribbon" id="ribbon" aria-hidden="true"></div><div class="closed-spine" id="closed-spine" aria-hidden="true"></div><div class="closed-edge" id="closed-edge" aria-hidden="true"></div>
<div class="cover-leaf" id="cover-leaf"><div class="leaf-face leaf-front cover-front cover"><div class="cover-heading"><img class="cover-logo" role="img" src="/book/assets/club-logo-v8.svg" alt="Logo CLB Yêu Sách Bách Khoa: trang sách mở trong hình bán nguyệt" width="1395" height="745" draggable="false"><h1 aria-label="Câu lạc bộ Yêu Sách Bách Khoa Hà Nội"><small>Câu lạc bộ</small><span class="cover-title-line">Yêu Sách</span><span class="cover-title-line">Bách Khoa <span class="cover-title-place">Hà Nội</span></span></h1><svg class="cover-tagline" viewBox="0 0 400 95" role="img" aria-label="Mở sách, đọc tương lai"><defs><path id="cover-tagline-arc" d="M20 75 Q200 25 380 75"/></defs><text><textPath href="#cover-tagline-arc" startOffset="50%" text-anchor="middle">Mở sách, đọc tương lai</textPath></text></svg></div><div class="cover-footer"><img class="partner-logos" src="/book/assets/partner-logos-clean-v8.svg" alt="Đại học Bách khoa Hà Nội và Hội Sinh viên" width="1774" height="887" draggable="false"></div></div><div class="leaf-face leaf-back" id="cover-back" aria-hidden="true"></div></div>
</div></div>

<nav class="book-side-controls" aria-label="Lật trang sách"><button type="button" class="page-arrow" id="previous" aria-label="Trang trước hoặc đóng bìa" disabled>←</button><button type="button" class="page-arrow" id="next" aria-label="Mở sách">→</button></nav>
<footer class="bottom-bar"><div class="reading-status"><span class="eyebrow" id="status-eyebrow">Bìa sách / Mở đầu</span><p class="status-title" id="status-title">Câu chuyện đang chờ bạn mở.</p><p class="status-caption" id="status-caption">Cuộn chậm để ngắm. Cuộn ngược để trở về.</p></div><div class="controls" aria-label="Điều khiển sách"><nav class="chapter-nav" id="chapter-nav" aria-label="Chọn chương"></nav></div><div class="bottom-right"><button type="button" class="mode-toggle" id="music-toggle" aria-pressed="false" aria-label="Bật hoặc tắt nhạc nền">Bật nhạc ♫</button><button type="button" class="mode-toggle" id="motion-toggle" aria-pressed="false">Giảm chuyển động</button></div></footer>
<div class="progress-track" aria-hidden="true"><div class="progress-fill" id="progress-fill"></div></div><p class="sr-only" id="chapter-announcement" role="status" aria-live="polite"></p><p class="notice" id="notice" hidden>Đã đến trang cuối. Cuộn lên hoặc dùng mũi tên trái để đọc lại.</p>
</main></div>
<div class="print-chapters" id="print-chapters" hidden></div>
<noscript><div class="fallback"><h2>Câu lạc bộ Yêu Sách Bách Khoa Hà Nội</h2><p>Thành lập ngày 16/09/2013. Một cộng đồng sinh viên cùng đọc, chia sẻ và lan tỏa tình yêu sách.</p><p>Cuốn sách tương tác cần JavaScript. Bạn vẫn có thể đọc hướng dẫn mượn bên dưới.</p></div></noscript>

<script is:inline type="module" src="/book/book.mjs"></script>
