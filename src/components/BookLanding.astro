---
import '../styles/book-landing.css';
import LandingLink from './LandingLink.astro';

interface Props {
  site?: any;
}

const { site = {} } = Astro.props;
const brand = site.brand || { name: 'Câu lạc bộ Yêu Sách Bách Khoa Hà Nội', tagline: 'Mở sách, đọc tương lai' };
const labels = site.labels || {};
const background = site.background || {};
const chapters = site.chapters || [];
---

<a class="skip" href={site.cta?.href || "#cach-muon"}>{labels.skip || "Đi đến hướng dẫn mượn sách"}</a>
<div class="scroll-track" id="scroll-track"><main class="stage" aria-label={brand.name} data-backdrop={background.calibration ? JSON.stringify(background.calibration) : undefined}><h1 class="sr-only">{brand.name}</h1>
<div class="desk-ring" aria-hidden="true"></div>
<header class="topbar"><div class="top-left"><a class="wordmark" href="#" id="home-link">{brand.name}</a></div><nav class="top-actions" aria-label={labels.navigation || "Lối vào nhanh"}><LandingLink href="/sach/" target="ysbk-public" rel="noopener" class="catalog-link">Tủ sách CLB ↗</LandingLink><LandingLink href="/sach/?tab=tra-don" class="subtle">Đăng nhập</LandingLink></nav></header>
<aside class="hint"><p><strong id="hint-title">{labels.openHint || "Cuộn xuống để mở sách"}</strong><br><span id="hint-copy">{labels.arrowsHint || "Hoặc dùng mũi tên trái / phải."}</span></p><span class="hint-line" aria-hidden="true"></span></aside>
<div class="book-area"><div class="book-shell" id="book-shell">
<div class="book-bed" id="book-bed"></div><div class="page-edges" id="page-edges"></div><div class="spread" id="base-spread" role="region" aria-label="Trang đang đọc"></div>
<div class="turn-leaf" id="turn-leaf" aria-hidden="true"><div class="leaf-face leaf-front" id="turn-front"></div><div class="leaf-face leaf-back" id="turn-back"></div><div class="turn-shade" id="turn-shade"></div></div>
<div class="curl-faces" id="curl-faces" aria-hidden="true" inert><div class="curl-front-holder" id="curl-front"></div><div class="curl-back-holder" id="curl-back"><div class="curl-back-content" id="curl-back-content"></div></div><svg class="curl-art" id="curl-art" aria-hidden="true"><defs><linearGradient id="curl-gradient" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#354a32" stop-opacity="0"/><stop offset=".22" stop-color="#354a32" stop-opacity=".2"/><stop offset=".49" stop-color="#fffdf0" stop-opacity=".94"/><stop offset=".73" stop-color="#8a8c69" stop-opacity=".25"/><stop offset="1" stop-color="#8a8c69" stop-opacity="0"/></linearGradient></defs><polygon class="curl-cast" id="curl-cast"/><path class="curl-ridge" id="curl-ridge" stroke="url(#curl-gradient)"/></svg></div>
<div class="gutter" id="gutter" aria-hidden="true"></div><div class="ribbon" id="ribbon" aria-hidden="true"></div><div class="closed-spine" id="closed-spine" aria-hidden="true"></div><div class="closed-edge" id="closed-edge" aria-hidden="true"></div>
<div class="cover-leaf" id="cover-leaf"><div class="leaf-face leaf-front cover-front cover"><div class="cover-heading"><img class="cover-logo" role="img" src="/book/assets/club-logo-v8.svg" alt="Logo CLB Yêu Sách Bách Khoa: trang sách mở trong hình bán nguyệt" width="1395" height="745" draggable="false"><h1 aria-label="Câu lạc bộ Yêu Sách Bách Khoa Hà Nội"><small>Câu lạc bộ</small><span class="cover-title-line">Yêu Sách</span><span class="cover-title-line">Bách Khoa Hà Nội</span></h1><svg class="cover-tagline" viewBox="0 0 400 95" role="img" aria-label="Mở sách, đọc tương lai"><defs><path id="cover-tagline-arc" d="M20 75 Q200 25 380 75"/></defs><text><textPath href="#cover-tagline-arc" startOffset="50%" text-anchor="middle">Mở sách, đọc tương lai</textPath></text></svg></div><div class="cover-footer"><img class="partner-logos" src="/book/assets/partner-logos-clean-v8.svg" alt="Đại học Bách khoa Hà Nội và Hội Sinh viên" width="1774" height="887" draggable="false"></div></div><div class="leaf-face leaf-back" id="cover-back" aria-hidden="true"></div></div>
</div></div>

<div class="single-control-dock"><nav class="book-side-controls" aria-label={labels.pageNavigation || "Lật trang sách"}><button type="button" class="page-arrow" id="previous" aria-label={labels.previousPage || "Trang trước hoặc đóng bìa"} disabled>←</button><button type="button" class="page-arrow" id="next" aria-label={labels.openBook || "Mở sách"}>→</button></nav>
<div class="single-reading-status"><p id="single-counter">{labels.coverPage || "Bìa sách"}</p><p>{labels.singleHint || "Kéo mép hoặc vuốt để lật · Cuộn để đọc"}</p></div>
<footer class="bottom-bar"><div class="reading-status"><span class="eyebrow" id="status-eyebrow">{labels.coverStatus || "Bìa sách / Mở đầu"}</span><p class="status-title" id="status-title">{labels.coverTitle || "Câu chuyện đang chờ bạn mở."}</p><p class="status-caption" id="status-caption">{labels.coverCaption || "Cuộn chậm để ngắm. Cuộn ngược để trở về."}</p></div><div class="controls" aria-label={labels.controls || "Điều khiển sách"}><nav class="chapter-nav" id="chapter-nav" aria-label={labels.chapters || "Chọn chương"}></nav></div><div class="bottom-right"><button type="button" class="mode-toggle" id="music-toggle" aria-pressed="false" aria-label={labels.music || "Bật hoặc tắt nhạc nền"}>{labels.musicOn || "Bật nhạc ♫"}</button><button type="button" class="mode-toggle" id="motion-toggle" aria-pressed="false">{labels.reduceMotion || "Giảm chuyển động"}</button></div></footer></div>
<div class="progress-track" aria-hidden="true"><div class="progress-fill" id="progress-fill"></div></div><p class="sr-only" id="chapter-announcement" role="status" aria-live="polite"></p><p class="notice" id="notice" hidden>{labels.endNotice || "Đã đến trang cuối. Cuộn lên hoặc dùng mũi tên trái để đọc lại."}</p>
</main></div>
<div class="print-chapters" id="print-chapters" hidden></div>
<section class="fallback static-story sr-only" aria-label={labels.completeStory || "Toàn bộ câu chuyện"}>{chapters.map((chapter: any) => <article id={"story-" + chapter.id} aria-labelledby={"story-title-" + chapter.id}><h2 id={"story-title-" + chapter.id}>{chapter.name}</h2>{chapter.title && <p>{chapter.title}</p>}{chapter.lines?.map((line: string) => <p>{line}</p>)}{chapter.photos?.map((photo: any) => <p>{photo.caption || photo.alt}</p>)}{chapter.items?.map((item: any) => <p>{item.title}</p>)}{chapter.slogans?.map((line: string) => <p>{line}</p>)}</article>)}</section>

<script is:inline type="module" src="/book/book.mjs"></script>
