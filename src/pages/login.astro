---
import '../styles/global.css';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/book/assets/club-logo-v8.svg" />
    <title>Đăng Nhập — CLB Yêu Sách Bách Khoa Hà Nội</title>
  </head>
  <body class="bg-[#F8F3E7] flex items-center justify-center min-h-screen p-4 font-sans text-[#35483C]">
    <div class="max-w-md w-full bg-[#FFFDF5] rounded-[22px] shadow-[0_5px_18px_rgba(53,72,60,0.08)] border border-[#DCDED0] overflow-hidden">
      <div class="p-6 sm:p-8 text-center border-b border-[#DCDED0] bg-[#F8F3E7]/50">
        <img src="/book/assets/club-logo-v8.svg" alt="Logo YSBK" class="h-12 w-auto mx-auto mb-3 object-contain" />
        <h1 class="font-serif text-2xl font-bold text-[#365E4B]">Đăng Nhập Không Gian Nội Bộ</h1>
        <p class="text-xs text-[#64705C] mt-1.5 font-medium">Câu lạc bộ Yêu Sách Bách Khoa Hà Nội · Mở sách, đọc tương lai</p>
      </div>

      <div class="p-6 sm:p-8 space-y-6">
        <!-- Form 1: Thành viên nội bộ -->
        <form id="formInternal" class="space-y-4 text-xs">
          <div id="internalError" class="hidden p-3 bg-[#F7E7DB] rounded-[14px] border border-[#9B4D36]/30 text-[#9B4D36] text-xs font-medium space-y-1">
            <div id="internalErrorText"></div>
          </div>

          <div>
            <label for="internalUsername" class="block font-semibold text-[#35483C] mb-1.5">Tên đăng nhập nội bộ (Do CLB cấp):</label>
            <input 
              id="internalUsername"
              name="username"
              type="text" 
              required
              placeholder="Ví dụ: dung.bcn, anh.haucan, admin_bcn..." 
              autocomplete="username"
              class="w-full px-3.5 py-3 border border-[#DCDED0] rounded-[14px] bg-[#F8F3E7] text-[#35483C] text-sm focus:bg-[#FFFDF5] focus:border-[#365E4B] focus:outline-none min-h-[44px]"
            />
          </div>
          <div>
            <label for="internalPassword" class="block font-semibold text-[#35483C] mb-1.5">Mật khẩu:</label>
            <input 
              id="internalPassword"
              name="password"
              type="password" 
              required
              placeholder="Nhập mật khẩu nội bộ..."
              autocomplete="current-password"
              class="w-full px-3.5 py-3 border border-[#DCDED0] rounded-[14px] bg-[#F8F3E7] text-[#35483C] text-sm focus:bg-[#FFFDF5] focus:border-[#365E4B] focus:outline-none min-h-[44px]"
            />
          </div>
          <div class="p-3 bg-[#E8EDDF] rounded-[14px] border border-[#365E4B]/20 text-[#365E4B] text-[11px] leading-relaxed">
            Bạn cần tài khoản do CLB cấp để vào không gian nội bộ. Chưa có tài khoản? Hãy liên hệ Ban chủ nhiệm.
          </div>
          <button 
            type="submit"
            id="btnLoginSubmit"
            class="ui-btn ui-btn-primary w-full text-center py-3 rounded-[14px] font-bold text-sm min-h-[44px]"
          >
            Đăng Nhập Không Gian Nội Bộ
          </button>
        </form>

        <div class="pt-4 border-t border-[#DCDED0] text-center">
          <a href="/?public=1" class="text-xs text-[#64705C] hover:text-[#365E4B] font-medium transition">← Quay lại trang chủ công khai</a>
        </div>
      </div>
    </div>

    <script>
      const formInternal = document.getElementById('formInternal') as HTMLFormElement | null;
      const internalError = document.getElementById('internalError');
      const internalErrorText = document.getElementById('internalErrorText');
      const btnLoginSubmit = document.getElementById('btnLoginSubmit') as HTMLButtonElement | null;

      formInternal?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (internalError) internalError.classList.add('hidden');

        const usernameInput = document.getElementById('internalUsername') as HTMLInputElement | null;
        const passwordInput = document.getElementById('internalPassword') as HTMLInputElement | null;

        const username = usernameInput?.value.trim() || '';
        const password = passwordInput?.value || '';

        if (!username || !password) {
          if (internalError && internalErrorText) {
            internalErrorText.textContent = 'Vui lòng điền đầy đủ tên đăng nhập và mật khẩu.';
            internalError.classList.remove('hidden');
          }
          return;
        }

        if (btnLoginSubmit) {
          btnLoginSubmit.disabled = true;
          btnLoginSubmit.textContent = 'Đang xác thực...';
        }

        try {
          const res = await fetch('/api/v1/auth/login-internal', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password }),
            credentials: 'include',
          });

          const data = await res.json().catch(() => null);

          if (res.ok) {
            // Thành công -> chuyển tiếp vào không gian nội bộ
            window.location.href = '/noi-bo';
          } else {
            const msg = data?.error?.message || data?.message || `Lỗi đăng nhập (${res.status})`;
            if (internalError && internalErrorText) {
              internalErrorText.textContent = msg;
              internalError.classList.remove('hidden');
            }
          }
        } catch (err: any) {
          if (internalError && internalErrorText) {
            internalErrorText.textContent = 'Không thể kết nối đến máy chủ xác thực. Vui lòng thử lại sau.';
            internalError.classList.remove('hidden');
          }
        } finally {
          if (btnLoginSubmit) {
            btnLoginSubmit.disabled = false;
            btnLoginSubmit.textContent = 'Đăng Nhập Không Gian Nội Bộ';
          }
        }
      });
    </script>
  </body>
</html>
